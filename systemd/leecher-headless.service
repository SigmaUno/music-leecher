[Unit]
Description=Leecher Music Player headless backend
After=graphical-session-pre.target pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=%h/Work/leecher-music-player
ExecStart=%h/Work/leecher-music-player/app --headless %h/Work/leecher-music-player/library.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
